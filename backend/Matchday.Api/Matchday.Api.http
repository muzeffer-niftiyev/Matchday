@baseUrl = http://localhost:5289

###
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "logintest@example.com",
  "password": "testpass123"
}

### 2. Who am I?
GET {{baseUrl}}/auth/me
Authorization: Bearer {{login.response.body.token}}

### 3. Create a team (needs token)
# @name createTeam
POST {{baseUrl}}/teams
Content-Type: application/json
Authorization: Bearer {{login.response.body.token}}

{
  "name": "PSG",
  "city": "Baku"
}

### 4. All teams (public)
GET {{baseUrl}}/teams

### 5. Members of the team created in step 3 (public)
GET {{baseUrl}}/teams/{{createTeam.response.body.id}}/members

### 6. Members of a team that doesn't exist -> 404
GET {{baseUrl}}/teams/999/members


###
